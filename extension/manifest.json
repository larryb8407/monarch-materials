{
  "manifest_version": 3,
  "name": "Monarch Lead Finder",
  "version": "1.0.0",
  "description": "Pull contractor names and phone numbers from bid, permit and news pages into the Monarch Materials prospect list.",
  "icons": { "16": "icons/icon-192.png", "48": "icons/icon-192.png", "128": "icons/icon-512.png" },
  "action": { "default_title": "Monarch Lead Finder", "default_icon": { "16": "icons/icon-192.png", "32": "icons/icon-192.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
